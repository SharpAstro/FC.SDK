# Auto detect text files and normalise line endings
* text=auto

# C# / .NET — CRLF (Windows convention)
*.cs text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.slnx text eol=crlf

# Config / markup — LF
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf

# Shell scripts — always LF
*.sh text eol=lf

# Binary — no conversion
*.png binary
*.jpg binary
*.jpeg binary

# Canon raw fixtures live in LFS so the repo stays slim. CI is configured to
# pointer-hash-cache + narrow-pull (.github/workflows/dotnet.yml) so bandwidth
# is only consumed when the fixture set actually changes.
*.cr2 filter=lfs diff=lfs merge=lfs -text
*.cr3 filter=lfs diff=lfs merge=lfs -text
*.CR2 filter=lfs diff=lfs merge=lfs -text
*.CR3 filter=lfs diff=lfs merge=lfs -text
*.cr2.gz filter=lfs diff=lfs merge=lfs -text
