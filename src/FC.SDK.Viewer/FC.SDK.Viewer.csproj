<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FC.SDK.Viewer</RootNamespace>
    <AssemblyName>fc-viewer</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <!-- Released as a self-contained native binary per RID so a bug reporter can run it without
         installing a .NET SDK — the whole point is lowering the cost of getting a log back. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- DIR.Lib's convention: alias the nested Layout namespace instead of importing its
       collision-prone barewords (Node, Content, Size<T>). -->
  <ItemGroup>
    <Using Include="DIR.Lib.Layout" Alias="Layout" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FC.SDK\FC.SDK.csproj" />
    <!-- Raw: decodes a downloaded CR2/CR3 so a capture can be verified in-app. Also the path
         through which SharpAstro.Jpeg (live-view + thumbnail JPEG decode) arrives. -->
    <ProjectReference Include="..\FC.SDK.Raw\FC.SDK.Raw.csproj" />
  </ItemGroup>

  <!-- Renderer siblings (SdlVulkan.Renderer + DIR.Lib). ProjectReference when the working copies
       are checked out next to this repo, otherwise the published packages. Detection lives in
       src/Directory.Build.props. Override: dotnet build -p:UseLocalSiblings=false -->
  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <ProjectReference Include="..\..\..\SdlVulkan.Renderer\src\SdlVulkan.Renderer\SdlVulkan.Renderer.csproj" />
    <ProjectReference Include="..\..\..\DIR.Lib\src\DIR.Lib\DIR.Lib.csproj" />
    <ProjectReference Include="..\..\..\AppShell\src\SharpAstro.AppShell\SharpAstro.AppShell.csproj" />
    <!-- Heif: decodes a .HIF/.HEIC capture (Canon HDR PQ) to linear-light floats for the HDR preview. -->
    <ProjectReference Include="..\..\..\Codecs\src\SharpAstro.Heif\SharpAstro.Heif.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <!-- 7.84 is the first with HDR: VulkanContext.Create(hdr: true), VkTexture.CreateFromRgbaFloat,
         VkRenderer.DrawHdrImage. 7.85 is the floor because the 7.83 and 7.84 packages depended on
         DIR.Lib.Debug instead of DIR.Lib, which would put two DIR.Lib assemblies in this build. -->
    <PackageReference Include="SdlVulkan.Renderer" Version="7.85.*" />
    <!-- Not below the DIR.Lib that SdlVulkan.Renderer 7.84 was built against (11.48). -->
    <PackageReference Include="DIR.Lib" Version="11.48.*" />
    <!-- The single-instance gate, shared with the TianWen viewer and GUI. -->
    <!-- 1.2 is SdlVulkan.Renderer 7.84's floor; 1.1 fails restore with NU1605. -->
    <PackageReference Include="SharpAstro.AppShell" Version="1.2.*" />
    <!-- Heif: decodes a .HIF/.HEIC capture (Canon HDR PQ) to linear-light floats for the HDR preview.
         3.33 is the first release with it (3.33.1613). -->
    <PackageReference Include="SharpAstro.Heif" Version="3.33.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versions kept in lockstep with the other SharpAstro renderer consumers (tianwen). -->
    <PackageReference Include="SDL3-CS" Version="3.5.0-preview.20260213-150035" NoWarn="NU5104" />
    <!-- Ships the native SDL3 binary; the renderer package deliberately leaves it to the app. -->
    <PackageReference Include="SDL3-CS.Native" Version="3.5.0-preview.20260205-174353" NoWarn="NU5104" />
    <!-- Must not sit below what SdlVulkan.Renderer requires, or restore fails NU1605 as a package
         downgrade. The renderer is pinned by a floating minor here, so its transitive floor can
         move under a version this file states exactly. -->
    <PackageReference Include="Vortice.Vulkan" Version="3.2.3" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.5" />
  </ItemGroup>

</Project>
