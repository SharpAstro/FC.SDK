<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- A harness, not a shipped artefact. The library projects opt into packing explicitly; this
         one must not follow them into NuGet. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FC.SDK\FC.SDK.csproj" />
    <!-- FocusScore decodes the delivered CR2, because the 0x9128 autofocus question cannot be
         answered from a response code: every row answers OK and delivers a frame either way. -->
    <ProjectReference Include="..\FC.SDK.Raw\FC.SDK.Raw.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.10" />
  </ItemGroup>

</Project>
