<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FC.SDK.Raw</RootNamespace>
    <AssemblyName>FC.SDK.Raw</AssemblyName>
    <PackageId>FC.SDK.Raw</PackageId>
    <PackageTags>Astronomy,Canon,CR2,CR3,RAW,DSLR,Demosaic,TIFF</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <DebugType>embedded</DebugType>
    <PackageLicenseFile>license.txt</PackageLicenseFile>
    <RepositoryUrl>https://github.com/SharpAstro/FC.SDK</RepositoryUrl>
    <PackageProjectUrl>https://github.com/SharpAstro/FC.SDK</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Description>Canon CR2 / CR3 raw-file decoder — pure managed C#, no external libraw / dcraw / EDSDK. Sibling to FC.SDK (Canon PTP device communication): one package for talking to the camera, one for decoding the files it writes.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Share FC.SDK's license/readme so both packages ship identical metadata. -->
    <None Include="..\FC.SDK\license.txt" PackagePath="" Pack="True" />
    <None Include="..\..\README.md" PackagePath="" Pack="True" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FC.SDK.Raw.Tests" />
  </ItemGroup>

  <!-- SharpAstro codec packages (sibling repo: Codecs). ProjectReference when the working
       copies are present locally, otherwise the published NuGet packages. The detection
       itself lives in src/Directory.Build.props so every project in this repo agrees on
       whether the graph is local. Override: dotnet build -p:UseLocalSiblings=false -->
  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <!-- Jpeg: SOF3 lossless JPEG (LosslessJpeg) decode for the CR2 raw IFD payload. -->
    <ProjectReference Include="..\..\..\Codecs\src\SharpAstro.Jpeg\SharpAstro.Jpeg.csproj" />
    <!-- Exif: standard EXIF parse for IFD0 metadata + access to Canon MakerNote bytes. -->
    <ProjectReference Include="..\..\..\Codecs\src\SharpAstro.Exif\SharpAstro.Exif.csproj" />
    <!-- Tiff: walk CR2's IFD chain to locate the raw IFD (transitively via Exif). -->
    <ProjectReference Include="..\..\..\Codecs\src\SharpAstro.Tiff\SharpAstro.Tiff.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <PackageReference Include="SharpAstro.Jpeg" Version="3.8.*" />
    <PackageReference Include="SharpAstro.Exif" Version="3.8.*" />
    <PackageReference Include="SharpAstro.Tiff" Version="3.8.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.200" PrivateAssets="All" />
  </ItemGroup>

</Project>
