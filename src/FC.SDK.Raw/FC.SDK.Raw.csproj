<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FC.SDK.Raw</RootNamespace>
    <AssemblyName>FC.SDK.Raw</AssemblyName>
    <PackageId>FC.SDK.Raw</PackageId>
    <PackageTags>Astronomy,Canon,CR2,CR3,RAW,DSLR,Demosaic,TIFF</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <DebugType>embedded</DebugType>
    <PackageLicenseFile>license.txt</PackageLicenseFile>
    <RepositoryUrl>https://github.com/SharpAstro/FC.SDK</RepositoryUrl>
    <PackageProjectUrl>https://github.com/SharpAstro/FC.SDK</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Description>Canon CR2 / CR3 raw-file decoder — pure managed C#, no external libraw / dcraw / EDSDK. Sibling to FC.SDK (Canon PTP device communication): one package for talking to the camera, one for decoding the files it writes.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Share FC.SDK's license/readme so both packages ship identical metadata. -->
    <None Include="..\FC.SDK\license.txt" PackagePath="" Pack="True" />
    <None Include="..\..\README.md" PackagePath="" Pack="True" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FC.SDK.Raw.Tests" />
  </ItemGroup>

  <!-- DIR.Lib (TiffReader + ExifReader) and SharpAstro.StbImage (SOF3 lossless JPEG)
       are the two sibling SharpAstro packages this decoder is built on. When a local
       working copy of both is present, switch to ProjectReference for fast iteration
       across all three repos; otherwise fall through to the published NuGet packages
       (CI / consumer builds). Override: dotnet build -p:UseLocalSiblings=false -->
  <PropertyGroup>
    <UseLocalSiblings Condition="'$(UseLocalSiblings)' == ''
      AND Exists('$(MSBuildThisFileDirectory)..\..\..\DIR.Lib\src\DIR.Lib\DIR.Lib.csproj')
      AND Exists('$(MSBuildThisFileDirectory)..\..\..\StbImageSharp\src\StbImageSharp.csproj')">true</UseLocalSiblings>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' == 'true'">
    <ProjectReference Include="..\..\..\DIR.Lib\src\DIR.Lib\DIR.Lib.csproj" />
    <ProjectReference Include="..\..\..\StbImageSharp\src\StbImageSharp.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSiblings)' != 'true'">
    <PackageReference Include="DIR.Lib" Version="2.15.0" />
    <PackageReference Include="SharpAstro.StbImage" Version="2.30.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.200" PrivateAssets="All" />
  </ItemGroup>

</Project>
